# Public website — copy to .env.local for local development.
# Never commit real secrets.
#
# Without NEXT_PUBLIC_API_URL, next build uses the production API host.
# Local next dev defaults to http://localhost:4000, but always set this explicitly.

# Backend API origin (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public site URL (metadata / sitemap) — match the port you run next on
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Workshop app — post signup/login redirect target
# IMPORTANT: include the port. Bare http://localhost goes to port 80 (often Caddy).
# Match whatever port you run the workshop with, e.g. 3000 or 3002.
NEXT_PUBLIC_WORKSHOP_APP_URL=http://localhost:3002

# Force mock auth/contact/signup (default: real API)
# NEXT_PUBLIC_USE_MOCK_PUBLIC_API=true
